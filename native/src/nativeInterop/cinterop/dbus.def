package = lapse.dbus
headers = dbus/dbus.h
headerFilter = dbus/**
compilerOpts = -I/usr/include/dbus-1.0 -I/usr/lib/x86_64-linux-gnu/dbus-1.0/include -I/usr/lib/aarch64-linux-gnu/dbus-1.0/include -I/usr/include -I/usr/include/x86_64-linux-gnu -I/usr/include/aarch64-linux-gnu
linkerOpts = -L/usr/lib/x86_64-linux-gnu -L/usr/lib/aarch64-linux-gnu -ldbus-1
---
